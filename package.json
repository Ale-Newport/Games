{
  "name": "arcade-ai-lab",
  "private": true,
  "version": "1.1.0",
  "description": "236 fully playable browser games with pure, seeded rules engines that double as AI research environments.",
  "keywords": [
    "browser-games",
    "html5-games",
    "game-ai",
    "reinforcement-learning",
    "mcts",
    "board-games",
    "chess",
    "solitaire",
    "puzzle-games",
    "react",
    "typescript",
    "vite",
    "github-pages"
  ],
  "homepage": "https://ale-newport.github.io/Games/",
  "bugs": {
    "url": "https://github.com/Ale-Newport/Games/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ale-Newport/Games.git"
  },
  "license": "MIT",
  "author": "Alejandro Newport Diaz (https://github.com/Ale-Newport)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:game": "node tools/test-game.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "validate:roadmap": "vitest run tests/platform/roadmap.test.ts",
    "roadmap": "tsx tools/generate-roadmap.ts",
    "env-server": "tsx tools/env-server.ts",
    "evaluate": "tsx tools/evaluate.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "media": "tsx tools/record-media.ts",
    "start": "vite"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "d3-geo": "^3.1.2",
    "flag-icons": "^7.6.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "i18n-iso-countries": "^7.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  }
}
